# =============================================================================
# DrGame E-Commerce Platform — Environment Variables Example
# =============================================================================

PROJECT_NAME="DrGame E-Commerce Platform"
ENVIRONMENT=development
DEBUG=true

# --- Backend Host & Ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000

# --- Frontend Host & Ports ---
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- PostgreSQL Database ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DB_HOST_PORT=8020
POSTGRES_DB=drgame_db
POSTGRES_USER=drgame_user
POSTGRES_PASSWORD=drgame_secure_pass_2026
DATABASE_URL=postgresql+asyncpg://drgame_user:drgame_secure_pass_2026@db:5432/drgame_db

# --- Redis In-Memory Cache ---
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_HOST_PORT=8021
REDIS_URL=redis://cache:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=drgame_super_secret_jwt_key_development_only_2026_cosmic_purple
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
WEBHOOK_SECRET_KEY=drgame_webhook_hmac_secret_key_2026

# --- RAWG Video Games Database API ---
RAWG_API_KEY=91c0c1c9c30c4796bbff63a7471fdfdd
RAWG_BASE_URL=https://api.rawg.io/api

# --- CORS Settings ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
