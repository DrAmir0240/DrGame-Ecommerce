# =============================================================================
# DrGame E-Commerce Platform — Environment Variables Example (.env.example)
# =============================================================================

PROJECT_NAME=
ENVIRONMENT=
DEBUG=

# --- Deployment & Regional Mode ---
# Values: domestic (Iran / Toman) | international (Global / USDT-USD)
DEPLOYMENT_MODE=domestic
DEFAULT_CURRENCY=IRT
NEXT_PUBLIC_DEPLOYMENT_MODE=domestic
NEXT_PUBLIC_DEFAULT_CURRENCY=IRT

# --- Backend Host & Ports ---
BACKEND_HOST=
BACKEND_PORT=
BACKEND_HOST_PORT=

# --- Frontend Host & Ports ---
FRONTEND_PORT=
FRONTEND_HOST_PORT=
NEXT_PUBLIC_API_URL=https://store.gamedr.ir/api

# --- PostgreSQL Database ---
POSTGRES_SERVER=
POSTGRES_PORT=
DB_HOST_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis In-Memory Cache ---
REDIS_HOST=
REDIS_PORT=
REDIS_HOST_PORT=
REDIS_URL=

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
WEBHOOK_SECRET_KEY=

# --- RAWG Video Games Database API ---
RAWG_API_KEY=
RAWG_BASE_URL=

# --- IGDB / Twitch OAuth API ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# --- CORS Settings ---
BACKEND_CORS_ORIGINS=

# --- Liara S3 Object Storage ---
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_PUBLIC_URL=

# --- Django Database Admin Microservice (Port 8007) ---
DJANGO_ADMIN_PORT=
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=
DJANGO_SECRET_KEY=
DJANGO_DB_SCHEMA=

