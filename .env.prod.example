# =============================================================================
# DrGame E-Commerce Platform — Production Environment Variables Example (.env.prod.example)
# =============================================================================

PROJECT_NAME=
ENVIRONMENT=
DEBUG=

# --- Backend Host & Ports ---
BACKEND_HOST=
BACKEND_PORT=
BACKEND_HOST_PORT=

# --- Frontend Host & Ports ---
FRONTEND_PORT=
FRONTEND_HOST_PORT=
NEXT_PUBLIC_API_URL=

# --- PostgreSQL Database ---
POSTGRES_SERVER=
POSTGRES_PORT=
DB_HOST_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis In-Memory Cache ---
REDIS_HOST=
REDIS_PORT=
REDIS_HOST_PORT=
REDIS_URL=

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
WEBHOOK_SECRET_KEY=

# --- RAWG Video Games Database API ---
RAWG_API_KEY=
RAWG_BASE_URL=

# --- CORS Settings ---
BACKEND_CORS_ORIGINS=

# --- Liara S3 Object Storage ---
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_PUBLIC_URL=

# --- Django Database Admin Microservice (Port 8007) ---
DJANGO_ADMIN_PORT=8007
DJANGO_ADMIN_USERNAME=superadmin
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=superadmin@drgame.local
DJANGO_SECRET_KEY=
DJANGO_DB_SCHEMA=django_admin
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Resource Limits (Optional) ---
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1024m
CACHE_CPU_LIMIT=0.5
CACHE_MEM_LIMIT=256m
BACKEND_CPU_LIMIT=1.5
BACKEND_MEM_LIMIT=1024m
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEM_LIMIT=1024m
ADMIN_PANEL_CPU_LIMIT=0.5
ADMIN_PANEL_MEM_LIMIT=512m

