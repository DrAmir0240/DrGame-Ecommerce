# =============================================================================
# DrGame E-Commerce Platform — Production Environment Variables Example (.env.prod.example)
# =============================================================================

PROJECT_NAME=
ENVIRONMENT=
DEBUG=

# --- Backend Host & Ports ---
BACKEND_HOST=
BACKEND_PORT=
BACKEND_HOST_PORT=

# --- Frontend Host & Ports ---
FRONTEND_PORT=
FRONTEND_HOST_PORT=
NEXT_PUBLIC_API_URL=https://store.gamedr.ir/api

# --- PostgreSQL Database ---
POSTGRES_SERVER=
POSTGRES_PORT=
DB_HOST_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis In-Memory Cache ---
REDIS_HOST=
REDIS_PORT=
REDIS_HOST_PORT=
REDIS_URL=

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
WEBHOOK_SECRET_KEY=

# --- RAWG Video Games Database API ---
RAWG_API_KEY=
RAWG_BASE_URL=

# --- IGDB / Twitch OAuth API ---
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# --- CORS Settings (Without trailing slashes) ---
BACKEND_CORS_ORIGINS=["https://store.gamedr.ir","https://api.gamedr.ir","https://admin.gamedr.ir","https://gamedr.ir","http://localhost:3000"]

# --- Liara S3 Object Storage ---
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_PUBLIC_URL=
