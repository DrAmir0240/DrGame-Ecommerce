# =============================================================================
# DrGame E-Commerce Platform — Production Environment Variables Example (.env.prod.example)
# =============================================================================

PROJECT_NAME=DrGame E-Commerce Platform
ENVIRONMENT=production
DEBUG=false

# --- Deployment & Regional Mode ---
# Values: domestic (Iran / Toman) | international (Global / USDT-USD)
DEPLOYMENT_MODE=domestic
DEFAULT_CURRENCY=IRT
NEXT_PUBLIC_DEPLOYMENT_MODE=domestic
NEXT_PUBLIC_DEFAULT_CURRENCY=IRT

# --- Backend Host & Ports ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000

# --- Frontend Host & Ports ---
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=https://store.gamedr.ir/api

# --- PostgreSQL Database ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DB_HOST_PORT=8020
POSTGRES_DB=drgame_db
POSTGRES_USER=drgame_user
POSTGRES_PASSWORD=your_strong_postgres_password
DATABASE_URL=postgresql+asyncpg://drgame_user:your_strong_postgres_password@db:5432/drgame_db

# --- Redis In-Memory Cache ---
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_HOST_PORT=8021
REDIS_URL=redis://cache:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
WEBHOOK_SECRET_KEY=generate_with_openssl_rand_hex_32

# --- RAWG Video Games Database API ---
RAWG_API_KEY=your_rawg_api_key
RAWG_BASE_URL=https://api.rawg.io/api

# --- IGDB / Twitch OAuth API ---
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# --- CORS Settings (Without trailing slashes) ---
BACKEND_CORS_ORIGINS=["https://store.gamedr.ir","https://api.gamedr.ir","https://admin.gamedr.ir","https://gamedr.ir","http://localhost:3000"]

# --- Liara S3 Object Storage ---
LIARA_ENDPOINT=https://storage.c2.liara.site
LIARA_BUCKET_NAME=your_bucket_name
LIARA_ACCESS_KEY=your_access_key
LIARA_SECRET_KEY=your_secret_key
LIARA_PUBLIC_URL=https://your_bucket_name.storage.c2.liara.site

# --- PS5 Download32 & DPoP Native Origin ---
DPOP_BASE_ORIGIN=https://dltest.gamedr.ir

# --- Django Database Admin Microservice (Port 8007) ---
DJANGO_ADMIN_PORT=8007
DJANGO_ADMIN_USERNAME=superadmin
DJANGO_ADMIN_PASSWORD=your_strong_admin_password
DJANGO_ADMIN_EMAIL=superadmin@drgame.local
DJANGO_SECRET_KEY=generate_with_openssl_rand_hex_32
DJANGO_DB_SCHEMA=django_admin
DJANGO_ALLOWED_HOSTS=admin.gamedr.ir,store.gamedr.ir,api.gamedr.ir,gamedr.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.gamedr.ir,https://store.gamedr.ir,https://api.gamedr.ir
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Production Resource Limits (Safe for single-core and multi-core servers) ---
DB_CPU_LIMIT=0.5
DB_MEM_LIMIT=1024m
CACHE_CPU_LIMIT=0.25
CACHE_MEM_LIMIT=256m
BACKEND_CPU_LIMIT=0.8
BACKEND_MEM_LIMIT=1024m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=1024m
ADMIN_PANEL_CPU_LIMIT=0.4
ADMIN_PANEL_MEM_LIMIT=512m
