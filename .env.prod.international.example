# =============================================================================
# DrGame E-Commerce Platform — Production Environment Example (International Mode)
# File: .env.prod.international.example
# =============================================================================

PROJECT_NAME="DrGame E-Commerce Platform (International)"
COMPOSE_PROJECT_NAME=drgame-intl-prod
CONTAINER_PREFIX=drgame-intl
ENVIRONMENT=production
DEBUG=false

# --- Deployment & Regional Mode (International) ---
DEPLOYMENT_MODE=international
DEFAULT_CURRENCY=USDT
NEXT_PUBLIC_DEPLOYMENT_MODE=international
NEXT_PUBLIC_DEFAULT_CURRENCY=USDT

# --- Backend Host & Offset Ports (8010 for International) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8010

# --- Frontend Host & Offset Ports (3010 for International) ---
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3010
NEXT_PUBLIC_API_URL=https://intl-api.gamedr.ir/api
NEXT_PUBLIC_STORAGE_URL=https://storage.gamedr.ir

# --- PostgreSQL Database (Isolated International DB on Port 8030) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DB_HOST_PORT=8030
POSTGRES_DB=drgame_intl_db
POSTGRES_USER=drgame_user
POSTGRES_PASSWORD=drgame_secure_pass_intl_2026
DATABASE_URL=postgresql+asyncpg://drgame_user:drgame_secure_pass_intl_2026@db:5432/drgame_intl_db

# --- Redis In-Memory Cache (Isolated Cache on Port 8031) ---
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_HOST_PORT=8031
REDIS_URL=redis://cache:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=drgame_jwt_intl_prod_secret_key_2026_cosmic_purple
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
WEBHOOK_SECRET_KEY=drgame_webhook_intl_hmac_secret_2026

# --- RAWG Video Games Database API ---
RAWG_API_KEY=91c0c1c9c30c4796bbff63a7471fdfdd
RAWG_BASE_URL=https://api.rawg.io/api

# --- IGDB / Twitch OAuth API ---
IGDB_CLIENT_ID=755p4548dxlbbe5n6xud3fnw3zjwsd
IGDB_CLIENT_SECRET=6fddqp62amcta340bymo4gjd4w2io0
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# --- CORS Settings (Allowed International Domains without trailing slashes) ---
BACKEND_CORS_ORIGINS=["https://intl-store.gamedr.ir","https://intl-api.gamedr.ir","https://intl-admin.gamedr.ir","https://store.gamedr.ir","https://api.gamedr.ir","https://admin.gamedr.ir","https://gamedr.ir","http://62.60.191.67:3000","http://62.60.191.67:8000","http://62.60.191.67:3010","http://62.60.191.67:8010","http://62.60.191.67:8007","http://62.60.191.67:8017","http://62.60.191.67","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:3010","http://127.0.0.1:3010","http://localhost:8010","http://127.0.0.1:8010","http://localhost:8007","http://127.0.0.1:8007","http://localhost:8017","http://127.0.0.1:8017"]

# --- Liara S3 Object Storage ---
LIARA_ENDPOINT=https://storage.c2.liara.site
LIARA_BUCKET_NAME=drgame-storage
LIARA_ACCESS_KEY=m9rvoec258l68eek
LIARA_SECRET_KEY=fb10fbac-cdd6-4ded-b574-4b297c1c678a
LIARA_PUBLIC_URL=https://storage.gamedr.ir

# --- PS5 Download32 & DPoP Native Origin ---
DPOP_BASE_ORIGIN=https://dltest.gamedr.ir

# --- Django Database Admin Microservice (Port 8017 for International) ---
DJANGO_ADMIN_PORT=8017
DJANGO_ADMIN_USERNAME=superadmin
DJANGO_ADMIN_PASSWORD=drgame_superadmin_secure_2026
DJANGO_ADMIN_EMAIL=superadmin@drgame.local
DJANGO_SECRET_KEY=drgame_django_admin_secret_key_prod_intl_2026_isolated
DJANGO_DB_SCHEMA=django_admin_intl
DJANGO_ALLOWED_HOSTS=intl-admin.gamedr.ir,intl-store.gamedr.ir,intl-api.gamedr.ir,62.60.191.67,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://intl-admin.gamedr.ir,https://intl-store.gamedr.ir,https://intl-api.gamedr.ir,http://62.60.191.67:8017,http://62.60.191.67:8007,http://62.60.191.67:3010,http://62.60.191.67:3000,http://localhost:8017,http://127.0.0.1:8017
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Production Resource Limits ---
DB_CPU_LIMIT=0.5
DB_MEM_LIMIT=1024m
CACHE_CPU_LIMIT=0.25
CACHE_MEM_LIMIT=256m
BACKEND_CPU_LIMIT=0.8
BACKEND_MEM_LIMIT=1024m
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=1024m
ADMIN_PANEL_CPU_LIMIT=0.4
ADMIN_PANEL_MEM_LIMIT=512m

# --- Anti-Censorship Proxy (Not needed on international server) ---
V2RAY_SUB_URL=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,cache,frontend,admin-panel,proxy
PROXY_HTTP_PORT=10819
