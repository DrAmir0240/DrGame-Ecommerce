# Pick whichever cover-art source you'd rather sign up for — you only need one.

# Leave blank to generate a one-time admin password on first start, or set your own.
ADMIN_PASSWORD=

# SteamGridDB: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# RAWG: https://rawg.io/apidocs
RAWG_API_KEY=

# Email (needed to send sign-up verification codes). Use any SMTP provider
# (Gmail app password, Mailgun, SendGrid, your hosting's mail server, ...).
# With SMTP_HOST empty, emails are NOT sent; they are saved to data/outbox.json
# and shown in the admin dashboard (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dr Game <no-reply@example.com>"

# Gmail API (OAuth2) alternative to SMTP. Create a Google OAuth desktop/web client,
# grant the Gmail send scope, and store the resulting refresh token here. Keep these secret.
# When all four values are present, Gmail API is preferred over SMTP.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM="Dr Game <your-gmail-address@example.com>"

# SMS (phone verification) via sms.ir: https://sms.ir  ->  Developer / API key
# Create a VERIFICATION template in your sms.ir panel (e.g. text "کد تأیید: #Code#"),
# then put its numeric id below. SMS_TEMPLATE_PARAM is the variable name used in it.
# Until all three are set, SMS are NOT sent (saved in data/sms-outbox.json for testing).
SMS_PROVIDER=smsir
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_TEMPLATE_PARAM=Code
# Sender line used for regular customer notification SMS messages.
SMS_LINE_NUMBER=
# Set to false to keep notification SMS in the local outbox without sending.
SMS_NOTIFICATIONS_ENABLED=true

# Telegram announcements (new game / new file). Create a bot with @BotFather, add it as ADMIN of your
# channel, then fill both lines. Empty = nothing is sent (messages are kept in data/telegram-outbox.json).
# Database. Leave empty to keep using the JSON files in data/ (fine for a small site). For many users use
# PostgreSQL, e.g.  DATABASE_URL=postgres://drgame:PASSWORD@localhost:5432/drgame   (database must be UTF8)
# On first start every data/*.json file is imported; after that the database is the master copy.
DATABASE_URL=
DATABASE_POOL=10
# DATABASE_SSL=1 when your host requires SSL (most managed databases do)

# Download links last this many minutes (default 5). DOWNLOAD_SECRET is optional (random key is made automatically).
DOWNLOAD_LINK_MINUTES=5
DOWNLOAD_SECRET=
# Set to cloudflare when the site is behind Cloudflare, so rate limits use the real visitor address.
TRUSTED_PROXY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
